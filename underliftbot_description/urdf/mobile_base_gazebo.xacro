<?xml version="1.0"?>
<robot name="underlift_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo reference="left_wheel_link">
        <mu1 value="10.0" />
        <mu2 value="10.0" />
        <kp value="500000.0"/>
        <kd value="10.0"/>
        <minDepth value="0.001"/>
        <fdir1>1 0 0</fdir1>
    </gazebo>

    <gazebo reference="right_wheel_link">
        <mu1 value="10.0" />
        <mu2 value="10.0" />
        <kp value="500000.0"/>
        <kd value="10.0"/>
        <minDepth value="0.001"/>
        <fdir1>1 0 0</fdir1>
    </gazebo>

    <gazebo reference="front_right_caster_wheel_link">
        <mu1 value="0.01" />
        <mu2 value="0.01" />
    </gazebo>

    <gazebo reference="front_left_caster_wheel_link">
        <mu1 value="0.01" />
        <mu2 value="0.01" />
    </gazebo>

    <gazebo reference="back_right_caster_wheel_link">
        <mu1 value="0.01" />
        <mu2 value="0.01" />
    </gazebo>

    <gazebo reference="back_left_caster_wheel_link">
        <mu1 value="0.01" />
        <mu2 value="0.01" />
    </gazebo> 

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find underliftbot_controller)/config/underliftbot_controllers.yaml</parameters>
        </plugin>

        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
        </plugin>

        <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat">
        </plugin>
    </gazebo>

</robot>