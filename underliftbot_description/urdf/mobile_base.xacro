<?xml version="1.0"?>
<robot name="underlift_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.679" />
    <xacro:property name="base_width" value="0.550" />
    <xacro:property name="base_height" value="0.075" />
    <xacro:property name="wheel_radius" value="0.05" />
    <xacro:property name="wheel_length" value="0.044" />
    <xacro:property name="caster_radius" value="0.035" />
    <xacro:property name="lift_height" value="0.005" />


    <link name="base_footprint" />

    <link name="base_link">
        <visual>
            <geometry>
                 <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="20.0" x="${base_length}" y="${base_width}" z="${base_height}"
                           o_xyz="0 0 ${base_height / 2.0}" o_rpy="0 0 0" />
    </link>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="black" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            </collision>
            <xacro:cylinder_inertia m="10.0" r="${wheel_radius}" l="${wheel_length}"
                                    o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0" />
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="right" />
    <xacro:wheel_link prefix="left" />

    <link name="front_right_caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="orange" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:sphere_inertia m="0.1" r="${caster_radius}"
                              o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <link name="front_left_caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="orange" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:sphere_inertia m="0.1" r="${caster_radius}"
                              o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <link name="back_left_caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="orange" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:sphere_inertia m="0.1" r="${caster_radius}"
                              o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>


    <link name="back_right_caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="orange" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:sphere_inertia m="0.1" r="${caster_radius}"
                              o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <link name="lift_link">
        <visual>
            <geometry>
                <box size="${base_length / 4} ${base_width / 4} ${lift_height}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <box size="${base_length / 4} ${base_width / 4} ${lift_height}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:box_inertia m="1.0" x="${base_length / 4}" y="${base_width / 4}" z="${lift_height}"
                           o_xyz="0 0 0.01" o_rpy="0 0 0" />
    </link>

    <link name="lift_surface_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} 0.01"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} 0.01"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:box_inertia m="10.0" x="${base_length}" y="${base_width}" z="0.01"
                           o_xyz="0 0 0.01" o_rpy="0 0 0" />
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${base_height / 2 + wheel_radius - base_height / 2}" rpy="0 0 0"/>
    </joint>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <origin xyz="0 -0.215 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <origin xyz="0 0.215 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_front_right_caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="front_right_caster_wheel_link" />
        <origin xyz="0.194 -0.149 ${-((base_height / 2 - caster_radius) + (wheel_radius - base_height / 2))}" rpy="0 0 0" />
    </joint>

    <joint name="base_front_left_caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="front_left_caster_wheel_link" />
        <origin xyz="0.194 0.149 ${-((base_height / 2 - caster_radius) + (wheel_radius - base_height / 2))}" rpy="0 0 0" />
    </joint>

    <joint name="base_back_right_caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="back_right_caster_wheel_link" />
        <origin xyz="-0.194 -0.149 ${-((base_height / 2 - caster_radius) + (wheel_radius - base_height / 2))}" rpy="0 0 0" />
    </joint>

    <joint name="base_back_left_caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="back_left_caster_wheel_link" />
        <origin xyz="-0.194 0.149 ${-((base_height / 2 - caster_radius) + (wheel_radius - base_height / 2))}" rpy="0 0 0" />
    </joint>

    <joint name="lift_joint" type="prismatic">
        <parent link="base_link"/>
        <child  link="lift_link"/>
        <origin xyz="0 0 ${base_height / 4 + 0.01}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0.0" upper="0.5" effort="5000.0" velocity="0.5"/>
    </joint>

    <joint name="lift_surface_joint" type="fixed">
        <parent link="lift_link"/>
        <child  link="lift_surface_link"/>
        <origin xyz="0 0 ${lift_height / 2}" rpy="0 0 0"/>
    </joint>

</robot>